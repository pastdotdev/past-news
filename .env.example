# Where past runs: https://api.past.dev for the cloud, or your self-hosted URL.
PAST_BASE_URL=https://api.past.dev

# Who the reader answers as. Reads see project-wide knowledge plus this identity's audiences.
PAST_IDENTITY=newsroom

# Path to the topics file (see topics.example.yaml).
NEWSROOM_TOPICS=topics.yaml

# One project key per topic. Each topic in topics.yaml names the variable holding its key.
NEWSROOM_KEY_AI_REGULATION=past_sk_...
NEWSROOM_KEY_CHIPS=past_sk_...
